# ============================================================================
# CODEBASE INDEX CLI - CONFIGURACIÓN GLOBAL
# ============================================================================
# Copia este archivo a ./.env (en la raíz del proyecto) y edítalo con tus
# credenciales. Este archivo se usa como configuración global para todos
# los workspaces.
#
# IMPORTANTE: Solo necesitas configurar UNA sección de embeddings
# (OpenAI, OpenAI-compatible, u Ollama) según el proveedor que uses.
# ============================================================================

# ----------------------------------------------------------------------------
# CONFIGURACIÓN GENERAL
# ----------------------------------------------------------------------------
# Nivel de logging: debug, info, warn, error
ROO_LOG_LEVEL=info

# Ruta del workspace (opcional, por defecto usa el directorio actual)
# CODEBASE_WORKSPACE_PATH=/abs/path/to/workspace

# Archivo de configuración JSON (opcional, si prefieres JSON en vez de ENV)
# CODEBASE_INDEX_CONFIG=./codebase-index.config.json


# ============================================================================
# VECTOR STORE - ELIGE UNO
# ============================================================================
# Opciones: "sqlite" (local, default) o "qdrant" (servidor remoto)
# - sqlite: Base de datos local, no requiere servicios externos
# - qdrant: Alto rendimiento, requiere servidor Qdrant corriendo
VECTOR_STORE=sqlite

# ----------------------------------------------------------------------------
# OPCIÓN 1: SQLite-vec (Local, Default)
# ----------------------------------------------------------------------------
# Base de datos local almacenada en tu proyecto
# ✅ No requiere servicios externos
# ✅ Portable, puede committearse con el proyecto
# ✅ Ideal para proyectos pequeños/medianos
SQLITE_DB_PATH=.codebase/vectors.db
SQLITE_SEARCH_MIN_SCORE=0.4
SQLITE_SEARCH_MAX_RESULTS=50

# ----------------------------------------------------------------------------
# OPCIÓN 2: Qdrant (Servidor Remoto)
# ----------------------------------------------------------------------------
# Requiere servidor Qdrant corriendo:
# docker run -p 6333:6333 qdrant/qdrant
# ✅ Alto rendimiento
# ✅ Escalable a millones de vectores
# ✅ Ideal para proyectos grandes o producción
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=
QDRANT_SEARCH_MIN_SCORE=0.4
QDRANT_SEARCH_MAX_RESULTS=50


# ============================================================================
# EMBEDDINGS - ELIGE UNO DE LOS SIGUIENTES
# ============================================================================
# Proveedor de embeddings: "openai", "openai-compatible", u "ollama"
EMBED_PROVIDER=openai-compatible

# ----------------------------------------------------------------------------
# OPCIÓN 1: OpenAI (Oficial)
# ----------------------------------------------------------------------------
# Usa la API oficial de OpenAI
# Requiere: OPENAI_API_KEY
# Modelos disponibles:
# - text-embedding-3-small (1536 dims, rápido, económico)
# - text-embedding-3-large (3072 dims, mejor calidad)
# - text-embedding-ada-002 (1536 dims, legacy)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_MAX_BATCH=60

# ----------------------------------------------------------------------------
# OPCIÓN 2: OpenAI-Compatible (Recomendado para APIs custom)
# ----------------------------------------------------------------------------
# Usa cualquier API compatible con OpenAI (Nebius, Together, etc.)
# Requiere: EMBED_BASE_URL, EMBED_API_KEY, EMBED_MODEL
#
# Ejemplo Nebius AI Studio:
# - Base URL: https://api.studio.nebius.com/v1/
# - Modelo: Qwen/Qwen3-Embedding-8B (4096 dims)
# - API Key: tu key de Nebius
EMBED_BASE_URL=https://api.studio.nebius.com/v1/
EMBED_API_KEY=tu-api-key-aqui
EMBED_MODEL=Qwen/Qwen3-Embedding-8B

# ----------------------------------------------------------------------------
# OPCIÓN 3: Ollama (Local, Auto-hospedado)
# ----------------------------------------------------------------------------
# Usa Ollama corriendo localmente
# Requiere: Ollama instalado y corriendo (ollama serve)
# Modelos disponibles: nomic-embed-text, mxbai-embed-large, etc.
# IMPORTANTE: Debes especificar la dimensión del modelo
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text
OLLAMA_EMBED_DIMENSION=768


# ============================================================================
# OPCIONES AVANZADAS
# ============================================================================

# ----------------------------------------------------------------------------
# Indexación
# ----------------------------------------------------------------------------
# Ruta del archivo de caché (hashes de archivos)
INDEXER_CACHE_PATH=.codebase/cache.json

# Tamaño del batch para embeddings (ajustar según límites de API)
INDEXER_BATCH_SIZE=64

# Tamaño máximo de archivo a indexar (en bytes, 1MB = 1048576)
INDEXER_MAX_FILE_SIZE_BYTES=1048576

# Patrones de archivos a indexar (glob patterns, separados por coma)
# Ejemplo: src/**/*.ts,src/**/*.tsx,lib/**/*.js
INDEXER_FILE_GLOBS=src/**/*.ts,src/**/*.tsx

# ----------------------------------------------------------------------------
# File Watcher
# ----------------------------------------------------------------------------
# Habilitar observador de cambios en archivos
INDEXER_WATCH_ENABLED=true

# Tiempo de espera antes de procesar cambios (en milisegundos)
INDEXER_WATCH_DEBOUNCE_MS=500

# ----------------------------------------------------------------------------
# Tree-sitter (Parsing Semántico)
# ----------------------------------------------------------------------------
# Habilitar parsing semántico con tree-sitter
# - true: Usa AST para dividir código por funciones/clases
# - false: Usa regex simple (default, más rápido)
# Soporta 29+ lenguajes (TypeScript, Python, Rust, etc.)
USE_TREE_SITTER=false
