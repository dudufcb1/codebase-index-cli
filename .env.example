# Copia este archivo a ./.env (en la raíz del proyecto) y edítalo con tus credenciales.
# Ese archivo se usa como configuración global para todos los workspaces.

# CODEBASE_WORKSPACE_PATH=/abs/path/to/workspace
# CODEBASE_INDEX_CONFIG=./codebase-index.config.json # opcional si quieres forzar un JSON
EMBED_PROVIDER=openai
ROO_LOG_LEVEL=info

# Qdrant vector store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=
QDRANT_SEARCH_MIN_SCORE=0.4
QDRANT_SEARCH_MAX_RESULTS=50

# OpenAI embeddings
OPENAI_API_KEY=sk-your-openai-key
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_MAX_BATCH=60

# OpenAI-compatible embeddings (set when using a custom base URL)
EMBED_BASE_URL=https://api.example.com/v1
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small

# Ollama embeddings (requires dimension override)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text
OLLAMA_EMBED_DIMENSION=1536

# Optional tuning
INDEXER_CACHE_PATH=.codebase/cache.json
INDEXER_BATCH_SIZE=64
INDEXER_MAX_FILE_SIZE_BYTES=1048576
INDEXER_FILE_GLOBS=src/**/*.ts,src/**/*.tsx
INDEXER_WATCH_ENABLED=true
INDEXER_WATCH_DEBOUNCE_MS=500
